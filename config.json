        "data_url":"https://storage.googleapis.com/download.tensorflow.org/data/speech_commands_v0.02.tar.gz",

        "keywords_dataset": "gscv2",
        
        "offline_noise_test_dataset": "demand",
        "offline_noise_train_dataset": "demand",
        "online_noise_test_dataset": "demand",
        "online_noise_train_dataset": "demand",
        
        "offline_noise_train": ["DKITCHEN", "DLIVING", "DWASHING", "NFIELD", "NPARK", "NRIVER", "OHALLWAY", "OOFFICE", "PCAFETER", "PRESTO", "PSTATION", "SCAFE", "SPSQUARE", "STRAFFIC", "TBUS", "TCAR", "TMETRO", "SILENCE"],
        "offline_noise_test": ["DKITCHEN", "DLIVING", "DWASHING", "NFIELD", "NPARK", "NRIVER", "OHALLWAY", "OOFFICE", "PCAFETER", "PRESTO", "PSTATION", "SCAFE", "SPSQUARE", "STRAFFIC", "TBUS", "TCAR", "TMETRO", "SILENCE"],
